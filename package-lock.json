{
  "name": "jeyos-gym-management",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "jeyos-gym-management",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=24 <25"
      }
    },
    "node_modules/@jeyos/client": {
      "resolved": "packages/client",
      "link": true
    },
    "node_modules/@jeyos/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@jeyos/online": {
      "resolved": "packages/online",
      "link": true
    },
    "node_modules/@jeyos/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@jeyos/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/client": {
      "name": "@jeyos/client",
      "version": "0.0.0",
      "dependencies": {
        "@jeyos/shared": "0.0.0"
      }
    },
    "packages/domain": {
      "name": "@jeyos/domain",
      "version": "0.0.0",
      "dependencies": {
        "@jeyos/shared": "0.0.0"
      }
    },
    "packages/online": {
      "name": "@jeyos/online",
      "version": "0.0.0",
      "dependencies": {
        "@jeyos/domain": "0.0.0",
        "@jeyos/shared": "0.0.0"
      }
    },
    "packages/server": {
      "name": "@jeyos/server",
      "version": "0.0.0",
      "dependencies": {
        "@jeyos/domain": "0.0.0",
        "@jeyos/shared": "0.0.0"
      }
    },
    "packages/shared": {
      "name": "@jeyos/shared",
      "version": "0.0.0"
    }
  }
}
