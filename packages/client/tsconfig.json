{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the client, so imports resolve the way a bundler does
    "module": "preserve",
    "lib": ["es2024", "dom"],
    "jsx": "react-jsx",
    // Vite's own types, so TypeScript knows what importing a .css file means
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
